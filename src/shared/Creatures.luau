function Creatures.get(id: string)
	local c = Creatures[id]
	if type(c) ~= "table" or c.base == nil then
		return nil
	end
	return c
end

function Creatures.starters(): { string }
	return { "Cindervix", "Mossling", "Ripplet" }
end

return Creatures
